# Environment variables — copy to .env and fill in real values
# cp .env.example .env

# ── Teacher model (data synthesis) ─────────────────────────────────────────
# Volcano ARK (DeepSeek / Doubao endpoints)
TEACHER_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TEACHER_API_KEY=your-ark-api-key-here
TEACHER_MODEL=ep-xxxx-deepseek-v3          # replace with your endpoint ID

# Alternative: DeepSeek official API
# TEACHER_BASE_URL=https://api.deepseek.com/v1
# TEACHER_API_KEY=your-deepseek-api-key
# TEACHER_MODEL=deepseek-chat

# Alternative: Alibaba DashScope (Qwen3-235B)
# TEACHER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# TEACHER_API_KEY=your-dashscope-api-key
# TEACHER_MODEL=qwen3-235b-a22b

# ── Student model (RL rollout — SGLang runs locally on GPU server) ──────────
# These defaults match the SGLang launch in train_grpo.sh; no changes needed.
STUDENT_BASE_URL=http://localhost:30000/v1
STUDENT_API_KEY=EMPTY
STUDENT_MODEL=Qwen/Qwen3-1.7B

# ── Optional: Weights & Biases logging ─────────────────────────────────────
# WANDB_API_KEY=your-wandb-key
# WANDB_PROJECT=agentic-qwen
