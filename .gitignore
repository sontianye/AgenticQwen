.env
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.venv/
venv/

# Large data files — keep directory structure via .gitkeep
data/personas/*.jsonl
data/seed_tasks/*.jsonl
data/synthesized/**/*.jsonl
data/synthesized/**/*.parquet
!data/**/.gitkeep

# Model checkpoints
checkpoints/*
!checkpoints/.gitkeep

# Evaluation results
results/*
!results/.gitkeep

# Logs
*.log
